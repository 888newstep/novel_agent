DEEPSEEK_API_KEY=your-deepseek-api-key
QIANWEN_API_KEY=your-qianwen-api-key
SILICONFLOW_API_KEY=your-siliconflow-api-key

# Generation token limits. Input memory is trimmed by priority before model invocation.
NOVEL_AGENT_PROMPT_TOKEN_BUDGET=1600
NOVEL_AGENT_RESERVED_COMPLETION_TOKENS=1200

# Embedding LRU cache. Long source text is deduplicated per batch but not retained across requests.
NOVEL_AGENT_EMBEDDING_CACHE_SIZE=1024
NOVEL_AGENT_EMBEDDING_CACHE_MAX_TEXT_CHARS=512

# Maximum base query length before retrieval variants and embeddings are generated.
NOVEL_AGENT_RETRIEVAL_MAX_QUERY_CHARS=240
NOVEL_AGENT_RETRIEVAL_MAX_TOTAL_QUERY_CHARS=480

# Required for Milvus admin endpoints and import finalization.
NOVEL_AGENT_ADMIN_API_KEY=replace-with-a-long-random-secret
# Semicolon-separated roots for import and knowledge files.
NOVEL_AGENT_FILE_ALLOWED_ROOTS=novels;artifacts

MYSQL_USERNAME=root
MYSQL_PASSWORD=your-mysql-password

# Reserved Redis logical database allocation for this project.
# novel_agent does not currently include a Redis client, so this value is
# ready for future integration but does not create a runtime dependency.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=2

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# Optional connectivity-preflight overrides.
# MYSQL_HOST=localhost
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
